{
  "$schema": "https://opencode.ai/config.json",
  // Route the built-in "synthetic" provider (models.dev, @ai-sdk/openai-compatible)
  // through the self-hosted gateway instead of api.synthetic.new directly. Auth
  // is OAuth via the plugin/ai-gateway-auth.ts plugin alongside this file
  // (`opencode auth login synthetic`), not an API key -- the gateway gates
  // access with Auth0 JWTs (llm:use), NOT Synthetic's own key.
  //
  // This file and plugin/ are the canonical copies; ~/.config/opencode
  // symlinks to them so this repo is the single source of truth for the
  // global opencode config.
  "provider": {
    "synthetic": {
      "options": {
        "baseURL": "https://ai.internal.willpxxr.com/v1"
      }
    }
  },
  // Remote MCP servers. Both use OAuth 2.1 browser flows that opencode
  // auto-detects; authenticate via the /mcp command after (re)starting
  // opencode.
  // - ai-gateway-mcp: the self-hosted AI Gateway MCP endpoint
  //   (apps/ai-gateway-mcp/). Client auth is the Auth0 PKCE flow against
  //   auth.willpxxr.com (mcp:use scope) via the MCP spec's OAuth discovery;
  //   upstream credential injection is handled in-cluster by
  //   apps/mcp-token-vault (WEP-0006) -- no Linear/API keys live client-side.
  "mcp": {
    "ai-gateway-mcp": {
      "type": "remote",
      "url": "https://mcp.internal.willpxxr.com/mcp",
      "enabled": true
    }
  }
}
